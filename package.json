{
  "name": "dsh-plugin-opencode-session",
  "version": "1.0.0",
  "description": "Restores the x-opencode-session routing header for OpenCode gateway routes in DeepSeek Harness, so turns stop failing with 400 MissingSessionID.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "opencode",
    "opencode-zen",
    "llm",
    "pi-ai"
  ],
  "type": "module",
  "license": "MIT",
  "author": "PiggyWu981 <piggywu@outlook.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Piggywu981/dsh-plugin-opencode-session.git"
  },
  "homepage": "https://github.com/Piggywu981/dsh-plugin-opencode-session#readme",
  "bugs": {
    "url": "https://github.com/Piggywu981/dsh-plugin-opencode-session/issues"
  },
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
